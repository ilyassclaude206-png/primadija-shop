rules_version = '2';

// ⚠️ NON UTILISÉ dans la config actuelle : le projet stocke les photos
// sur Cloudinary (gratuit, sans carte bancaire) plutôt que sur Firebase
// Storage (qui demande le plan payant "Blaze"). Ce fichier est gardé au
// cas où tu voudrais basculer sur Firebase Storage plus tard.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
