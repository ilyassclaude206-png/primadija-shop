rules_version = '2';

// À coller dans Firebase Console > Firestore Database > Règles
service cloud.firestore {
  match /databases/{database}/documents {

    // Produits : lecture publique (la boutique doit s'afficher pour tout
    // le monde), écriture réservée à l'admin connecté.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Commandes : n'importe qui peut EN CRÉER une (le client passe
    // commande sans compte), mais seule l'admin connectée peut les lire,
    // les modifier ou les supprimer.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
